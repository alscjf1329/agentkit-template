{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "sheepduck-ai-setup": {
      "source": { "source": "github", "repo": "alscjf1329/ai-stack-setup" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "stack-setup@sheepduck-ai-setup": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  }
}
